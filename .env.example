# Project Vanguard — board credentials
#
# Copy to `.env` (gitignored) and fill in. Loaded automatically by every
# vanguard command. An exported environment variable overrides this file.
#
# Adzuna — register free at https://developer.adzuna.com/signup
# The dashboard gives TWO values, not one.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed — register at https://www.reed.co.uk/developers
REED_API_KEY=

# --- Mailbox --------------------------------------------------------------
# The address monitored is DERIVED from the CV in use, so it cannot drift
# from what employers were actually given. These credentials say how to reach
# that mailbox.
#
# IMAP (any provider). Use an APP PASSWORD, never the account password —
# most providers refuse the account password once 2FA is on, and an app
# password can be revoked without changing the account.
#   Gmail:   myaccount.google.com/apppasswords
#   Outlook: account.microsoft.com/security
VANGUARD_MAIL_PROVIDER=imap
VANGUARD_MAIL_HOST=            # inferred from the address for common providers
VANGUARD_MAIL_USER=
VANGUARD_MAIL_PASSWORD=
VANGUARD_MAIL_FOLDER=INBOX
VANGUARD_MAIL_SINCE_DAYS=30

# Gmail only. Primary/Promotions/Social are NOT IMAP folders — INBOX returns
# all of them, so a recent-N fetch fills with promotional mail and a genuine
# reply can fall outside the window. `primary` restricts to the tab where
# employer replies actually land. Set `all` to read everything.
VANGUARD_MAIL_CATEGORY=primary

# Gmail API instead of IMAP. Needs a Google Cloud project with the Gmail API
# enabled and an OAuth client. Scope is gmail.readonly.
# VANGUARD_MAIL_PROVIDER=gmail
# VANGUARD_MAIL_TOKEN=secrets/gmail_token.json

# A second mailbox, for a CV using a different address. Same names, MAIL2.
# VANGUARD_MAIL2_USER=
# VANGUARD_MAIL2_PASSWORD=
